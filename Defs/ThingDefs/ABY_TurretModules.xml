      <texPath>Things/Item/TurretModules/ABY_TurretModule_RiftNeedlerCore</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stackLimit>10</stackLimit>
    <thingCategories><li>Manufactured</li></thingCategories>
    <tradeability>Sellable</tradeability>
    <statBases>
      <MarketValue>210</MarketValue>
      <Mass>2.2</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li Class="AbyssalProtocol.CompProperties_ABY_TurretModuleInfoCard" />
    </comps>
    <modExtensions>
      <li Class="AbyssalProtocol.DefModExtension_AbyssalForgeUnlock">
        <requiredResidue>80</requiredResidue>
        <category>TurretSystems</category>
      </li>
    </modExtensions>
  </ThingDef>

