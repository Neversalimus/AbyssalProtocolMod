<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ApparelBase">
    <defName>ABY_SaintAegisCarapace</defName>
    <thingClass>AbyssalProtocol.Apparel_ABY_ArmorAegis</thingClass>
    <label>saint aegis carapace</label>
    <description>A rebuilt torso shell forged from salvaged Infernal Reactor Saint plating, reactor housings and scorched containment ribs. It still looks like it belonged on a walking artillery-saint first and a human body second. The result is heavy, unnervingly clean, and markedly better at surviving heat and high-energy punishment than the first infernal combat line.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Apparel/ABY_SaintAegisCarapace</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.14,1.14)</drawSize>
    </graphicData>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
        <li>Neck</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
      <wornGraphicPath>Things/Apparel/ABY_SaintAegisCarapace</wornGraphicPath>
    </apparel>
    <tradeability>Sellable</tradeability>
    <smeltable>true</smeltable>
    <smeltProducts>
      <Plasteel>42</Plasteel>
      <Uranium>16</Uranium>
      <ComponentSpacer>2</ComponentSpacer>
      <Gold>4</Gold>
    </smeltProducts>
    <equippedStatOffsets>
      <MoveSpeed>-0.08</MoveSpeed>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>36000</WorkToMake>
      <MaxHitPoints>500</MaxHitPoints>
      <Mass>6.8</Mass>
      <MarketValue>5600</MarketValue>
      <ArmorRating_Sharp>1.12</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.58</ArmorRating_Blunt>
      <ArmorRating_Heat>1.00</ArmorRating_Heat>
    </statBases>
    <modExtensions>
      <li Class="AbyssalProtocol.DefModExtension_ABY_ApparelBodyTypeRestriction">
        <allowedBodyTypes>
          <li>Male</li>
          <li>Female</li>
          <li>Thin</li>
        </allowedBodyTypes>
      </li>
      <li Class="AbyssalProtocol.DefModExtension_ABY_ApparelAegis">
        <labelKey>ABY_ApparelAegis_SaintLabel</labelKey>
        <gizmoSubtitleKey>ABY_ApparelAegis_SaintGizmoSubtitle</gizmoSubtitleKey>
        <gizmoTheme>Saint</gizmoTheme>
        <gizmoTagKey>ABY_ApparelAegis_TagSaint</gizmoTagKey>
        <gizmoIconTexPath>UI/Gizmos/ABY_AegisSaint</gizmoIconTexPath>
        <maxShieldPoints>160</maxShieldPoints>
        <rechargeDelayTicks>540</rechargeDelayTicks>
        <rechargeIntervalTicks>30</rechargeIntervalTicks>
        <rechargePerInterval>1.5</rechargePerInterval>
        <absorbRanged>true</absorbRanged>
        <absorbExplosive>true</absorbExplosive>
        <absorbMelee>false</absorbMelee>
        <empDrainsShield>true</empDrainsShield>
        <empDrainMultiplier>2.4</empDrainMultiplier>
        <suppressWhenExternalShieldWorn>true</suppressWhenExternalShieldWorn>
        <hitFlashScale>0.85</hitFlashScale>
        <breakFlashScale>1.55</breakFlashScale>
        <restoreFlashScale>1.10</restoreFlashScale>
        <breakSoundDefName>ABY_ReactorSaintImpact</breakSoundDefName>
        <restoreSoundDefName>ABY_ReactorSaintCharge</restoreSoundDefName>
        <collapseTextKey>ABY_ApparelAegis_SaintTextCollapse</collapseTextKey>
        <restoreTextKey>ABY_ApparelAegis_SaintTextRestore</restoreTextKey>
        <collapsePulseStrength>0.42</collapsePulseStrength>
        <restorePulseStrength>0.24</restorePulseStrength>
      </li>
    </modExtensions>
    <comps>
      <li Class="AbyssalProtocol.CompProperties_ABY_ApparelAegisInfo" />
    </comps>
  </ThingDef>
  <ThingDef ParentName="ApparelBase">
    <defName>ABY_VesperHaloHelm</defName>
    <thingClass>Apparel</thingClass>
    <label>vesper halo helm</label>
    <description>A saint-line war helm rebuilt from reactor-saint face plating, signal crown fragments and scorched halo braces. Its visor geometry and reinforced cranial seal feel less like standard armor and more like a sanctioned remnant stripped from a boss-grade shell.</description>
