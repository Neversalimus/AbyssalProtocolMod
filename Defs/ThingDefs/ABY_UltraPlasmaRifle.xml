<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>ABY_UltraPlasmaRifle</defName>
    <label>ultra plasma rifle</label>
    <description>A plasma rifle rebuilt around breach records cut from heraldic architecture. It projects disciplined cyan overfire with extreme armor pressure and leaves the target struggling to contain what was forced through it.</description>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/PlasmaRifle_UHT</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.36,0.47)</drawSize>
    </graphicData>
    <soundInteract>Interact_ChargeRifle</soundInteract>
    <statBases>
      <WorkToMake>90000</WorkToMake>
      <Mass>6.5</Mass>
      <MarketValue>8500</MarketValue>
      <AccuracyTouch>0.54</AccuracyTouch>
      <AccuracyShort>0.68</AccuracyShort>
      <AccuracyMedium>0.60</AccuracyMedium>
      <AccuracyLong>0.46</AccuracyLong>
      <RangedWeapon_Cooldown>2.35</RangedWeapon_Cooldown>
    </statBases>
    <recipeMaker>
      <skillRequirements>
        <Crafting>12</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>ABY_AbyssalForge</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <ABY_ReactorSaintCore>1</ABY_ReactorSaintCore>
      <ABY_AbyssalResidue>75</ABY_AbyssalResidue>
      <Plasteel>220</Plasteel>
      <Uranium>45</Uranium>
      <Gold>35</Gold>
      <ComponentSpacer>16</ComponentSpacer>
      <Steel>220</Steel>
    </costList>
    <weaponTags>
      <li>SpacerGun</li>
    </weaponTags>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>ABY_UltraPlasmaBeamBurst</defaultProjectile>
        <warmupTime>1.20</warmupTime>
        <range>40.0</range>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <burstShotCount>3</burstShotCount>
        <soundAiming>ABY_UltraPlasmaCharge</soundAiming>
        <soundCast>ABY_UltraPlasmaFire</soundCast>
        <soundCastTail>ABY_UltraPlasmaTail</soundCastTail>
        <muzzleFlashScale>11</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>10</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <modExtensions>
      <li Class="AbyssalProtocol.DefModExtension_AbyssalForgeUnlock">
        <requiredResidue>5000</requiredResidue>
        <category>Herald</category>
        <requiredProtocolResearchDefName>ABY_PR_SaintAegisEngineering</requiredProtocolResearchDefName>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>ABY_UltraPlasmaBolt</defName>
    <label>ultra plasma bolt</label>
    <thingClass>Bullet</thingClass>
    <graphicData>
      <texPath>Things/Projectile/UltraPlasmaBolt</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.22,1.15)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Burn</damageDef>
      <damageAmountBase>22</damageAmountBase>
      <armorPenetrationBase>1.10</armorPenetrationBase>
      <stoppingPower>1.65</stoppingPower>
      <speed>85</speed>
      <soundImpactAnticipate>BulletImpact_Ground</soundImpactAnticipate>
    </projectile>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>ABY_UltraPlasmaBeamBurst</defName>
    <label>ultra plasma beam</label>
    <thingClass>AbyssalProtocol.Projectile_UltraPlasmaBurst</thingClass>
    <graphicData>
      <texPath>Things/Projectile/ABY_UltraPlasmaBeam_Long</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.34,2.75)</drawSize>
    </graphicData>
    <projectile>
      <damageDef>Burn</damageDef>
      <damageAmountBase>22</damageAmountBase>
      <armorPenetrationBase>1.10</armorPenetrationBase>
      <stoppingPower>1.65</stoppingPower>
      <speed>46</speed>
      <soundImpactAnticipate>BulletImpact_Ground</soundImpactAnticipate>
    </projectile>
  </ThingDef>
</Defs>