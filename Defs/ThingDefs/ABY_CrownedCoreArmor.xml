<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ApparelBase">
    <defName>ABY_CrownedCorePlate</defName>
    <thingClass>AbyssalProtocol.Apparel_ABY_ArmorAegis</thingClass>
    <label>crowned core plate</label>
    <description>A dominion-grade torso shell grown around a crowned core fragment recovered from the hell slice. The plate is less a suit of armor than a wearable administrative seal: blackened plasteel ribs, uranium heat channels and crown-pressure nodes hold a hostile fragment in a human-sized frame. It is heavy, rare, and built for colonists who have already crossed the gate once.</description>
    <techLevel>Ultra</techLevel>
    <graphicData>
      <texPath>Things/Item/Apparel/ABY_CrownedCorePlate</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.16,1.16)</drawSize>
    </graphicData>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Neck</li>
        <li>Legs</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
      <wornGraphicPath>Things/Apparel/ABY_CrownedCorePlate</wornGraphicPath>
    </apparel>
    <tradeability>Sellable</tradeability>
    <smeltable>true</smeltable>
    <smeltProducts>
      <Plasteel>54</Plasteel>
      <Uranium>18</Uranium>
      <ComponentSpacer>2</ComponentSpacer>
      <Gold>6</Gold>
    </smeltProducts>
    <equippedStatOffsets>
      <MoveSpeed>-0.06</MoveSpeed>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>62000</WorkToMake>
      <MaxHitPoints>590</MaxHitPoints>
      <Mass>7.5</Mass>
      <MarketValue>8200</MarketValue>
      <ArmorRating_Sharp>1.36</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.72</ArmorRating_Blunt>
      <ArmorRating_Heat>1.20</ArmorRating_Heat>
    </statBases>
    <modExtensions>
      <li Class="AbyssalProtocol.DefModExtension_ABY_ApparelBodyTypeRestriction">
        <allowedBodyTypes>
          <li>Male</li>
          <li>Female</li>
          <li>Thin</li>
        </allowedBodyTypes>
      </li>
      <li Class="AbyssalProtocol.DefModExtension_ABY_ApparelAegis">
        <labelKey>ABY_ApparelAegis_CrownLabel</labelKey>
        <gizmoSubtitleKey>ABY_ApparelAegis_CrownGizmoSubtitle</gizmoSubtitleKey>
        <gizmoTheme>Crown</gizmoTheme>
        <gizmoTagKey>ABY_ApparelAegis_TagCrown</gizmoTagKey>
        <gizmoIconTexPath>UI/Gizmos/ABY_AegisCrown</gizmoIconTexPath>
        <maxShieldPoints>130</maxShieldPoints>
        <rechargeDelayTicks>180</rechargeDelayTicks>
        <rechargeIntervalTicks>30</rechargeIntervalTicks>
        <rechargePerInterval>5.0</rechargePerInterval>
        <absorbRanged>true</absorbRanged>
        <absorbExplosive>true</absorbExplosive>
        <absorbMelee>false</absorbMelee>
        <empDrainsShield>true</empDrainsShield>
        <empDrainMultiplier>2.4</empDrainMultiplier>
        <suppressWhenExternalShieldWorn>true</suppressWhenExternalShieldWorn>
        <hitFlashScale>0.72</hitFlashScale>
        <breakFlashScale>1.30</breakFlashScale>
        <restoreFlashScale>1.30</restoreFlashScale>
        <breakSoundDefName>ABY_ReactorSaintImpact</breakSoundDefName>
        <restoreSoundDefName>ABY_ReactorSaintCharge</restoreSoundDefName>
        <collapseTextKey>ABY_ApparelAegis_CrownTextCollapse</collapseTextKey>
        <restoreTextKey>ABY_ApparelAegis_CrownTextRestore</restoreTextKey>
        <collapsePulseStrength>0.34</collapsePulseStrength>
        <restorePulseStrength>0.34</restorePulseStrength>
      </li>
    </modExtensions>
    <comps>
      <li Class="AbyssalProtocol.CompProperties_ABY_ApparelAegisInfo" />
    </comps>
  </ThingDef>
  <ThingDef ParentName="ApparelBase">
    <defName>ABY_CrownedCoreHelm</defName>
    <thingClass>Apparel</thingClass>
    <label>crowned core helm</label>
    <description>A sealed dominion helm built around a splintered crown logic lens. Its visor does not simply protect the wearer; it frames the battlefield as a set of authorized targets, breach vectors and condemned structures. The halo braces are intentionally restrained so the helm reads as wargear rather than ceremony.</description>
    <techLevel>Ultra</techLevel>
    <graphicData>
      <texPath>Things/Item/Apparel/ABY_CrownedCoreHelm</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.02,1.02)</drawSize>
    </graphicData>
    <apparel>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <layers>
        <li>Overhead</li>
      </layers>
      <wornGraphicPath>Things/Apparel/ABY_CrownedCoreHelm</wornGraphicPath>
    </apparel>
    <tradeability>Sellable</tradeability>
    <smeltable>true</smeltable>
    <smeltProducts>
      <Plasteel>20</Plasteel>
      <Uranium>6</Uranium>
      <ComponentIndustrial>1</ComponentIndustrial>
      <Gold>3</Gold>
    </smeltProducts>
    <equippedStatOffsets>
      <ShootingAccuracyPawn>0.10</ShootingAccuracyPawn>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>26000</WorkToMake>
      <MaxHitPoints>325</MaxHitPoints>
      <Mass>2.45</Mass>
      <MarketValue>3450</MarketValue>
      <ArmorRating_Sharp>1.16</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.60</ArmorRating_Blunt>
      <ArmorRating_Heat>1.00</ArmorRating_Heat>
    </statBases>
  </ThingDef>
</Defs>