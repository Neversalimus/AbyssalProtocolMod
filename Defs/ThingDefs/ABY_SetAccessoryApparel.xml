<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ApparelBase">
    <defName>ABY_GatebreakerAnchorHarness</defName>
    <thingClass>Apparel</thingClass>
    <label>gatebreaker anchor harness</label>
    <description>A visible recoil-anchor rig worn over the Gatebreaker carapace. Its diagonal breach straps, hip anchors and compact pressure core lock the wearer into each heavy shot, turning the armor into a human-scale firing brace rather than a simple suit of protection.</description>
    <techLevel>Ultra</techLevel>
    <graphicData>
      <texPath>Things/Item/Apparel/ABY_GatebreakerAnchorHarness</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.96,0.96)</drawSize>
    </graphicData>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <layers>
        <li>Belt</li>
      </layers>
      <wornGraphicPath>Things/Apparel/ABY_GatebreakerAnchorHarness</wornGraphicPath>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
    </apparel>
    <tradeability>Sellable</tradeability>
    <smeltable>true</smeltable>
    <smeltProducts>
      <Plasteel>16</Plasteel>
      <Uranium>4</Uranium>
      <ComponentIndustrial>1</ComponentIndustrial>
    </smeltProducts>
    <equippedStatOffsets>
      <ShootingAccuracyPawn>0.04</ShootingAccuracyPawn>
      <MoveSpeed>-0.02</MoveSpeed>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>2600</WorkToMake>
      <MaxHitPoints>220</MaxHitPoints>
      <Mass>1.8</Mass>
      <MarketValue>1450</MarketValue>
      <ArmorRating_Sharp>0.03</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.04</ArmorRating_Blunt>
      <ArmorRating_Heat>0.05</ArmorRating_Heat>
    </statBases>
    <modExtensions>
      <li Class="AbyssalProtocol.DefModExtension_AbyssalForgeUnlock">
        <requiredResidue>1800</requiredResidue>
        <category>Armor</category>
      </li>
    </modExtensions>
  </ThingDef>

