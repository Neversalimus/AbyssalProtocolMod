<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ApparelBase">
    <defName>ABY_InfernalCombatFrame</defName>
    <thingClass>Apparel</thingClass>
    <label>infernal combat frame</label>
    <description>A first-generation abyssal torso frame built as the body counterpart to the rift helm. Layered plasteel ribs, residue-lined plating and a sealed chest-core lattice make it durable enough for breach warfare without turning the wearer into dead weight.</description>
    <techLevel>Ultra</techLevel>
    <graphicData>
      <texPath>Things/Item/Apparel/ABY_InfernalCombatFrame</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.08,1.08)</drawSize>
    </graphicData>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Neck</li>
        <li>Legs</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
      <wornGraphicPath>Things/Apparel/ABY_InfernalCombatFrame</wornGraphicPath>
    </apparel>
    <tradeability>Sellable</tradeability>
    <smeltable>true</smeltable>
    <smeltProducts>
      <Steel>30</Steel>
      <Plasteel>28</Plasteel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </smeltProducts>
    <equippedStatOffsets>
      <MoveSpeed>-0.16</MoveSpeed>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>20000</WorkToMake>
      <MaxHitPoints>420</MaxHitPoints>
      <Mass>7.0</Mass>
      <MarketValue>5200</MarketValue>
      <ArmorRating_Sharp>1.04</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.44</ArmorRating_Blunt>
      <ArmorRating_Heat>0.58</ArmorRating_Heat>
    </statBases>
    <modExtensions>
      <li Class="AbyssalProtocol.DefModExtension_ABY_ApparelBodyTypeRestriction">
        <allowedBodyTypes>
          <li>Male</li>
          <li>Female</li>
          <li>Thin</li>
        </allowedBodyTypes>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>