<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ApparelBase">
    <defName>ABY_AbyssalGravplatePrototype</defName>
    <thingClass>AbyssalProtocol.Apparel_ABY_ArmorAegis</thingClass>
    <label>dominion gravplate shell</label>
    <description>A dominion survival frame that turns crown pressure into battlefield motion. The shell does not simply protect the wearer; it suspends their mass on a hostile vector lattice, sheds incoming fire through a fast internal aegis, and lets breach-line fighters cross kill zones before the ground can fully claim them.</description>
    <techLevel>Ultra</techLevel>
    <graphicData>
      <texPath>Things/Item/Apparel/ABY_AbyssalGravplatePrototype</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.16,1.16)</drawSize>
    </graphicData>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Neck</li>
        <li>Legs</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
      <wornGraphicPath>Things/Apparel/ABY_AbyssalGravplatePrototype</wornGraphicPath>
    </apparel>
    <modExtensions>
      <li Class="AbyssalProtocol.ABY_HoverArmorExtension">
        <draftedOnly>true</draftedOnly>
        <enableUnderfootFx>false</enableUnderfootFx>
        <enableMovingSparks>false</enableMovingSparks>
        <enableFlightRigFx>false</enableFlightRigFx>
        <enableVectorThrusterFx>true</enableVectorThrusterFx>
        <enableGroundWakeFx>true</enableGroundWakeFx>
        <vectorThrusterBurstTexPath>Effects/Hover/ABY_VectorThrusterBurst</vectorThrusterBurstTexPath>
        <vectorThrusterGlowTexPath>Effects/Hover/ABY_VectorThrusterGlow</vectorThrusterGlowTexPath>
        <groundWakeTexPath>Effects/Hover/ABY_GravWake</groundWakeTexPath>
        <groundDistortionTexPath>Effects/Hover/ABY_GravDistortion</groundDistortionTexPath>
        <hoverFxIntensity>Subtle</hoverFxIntensity>
        <ringScale>0.82</ringScale>
        <movingRingScaleBonus>0.10</movingRingScaleBonus>
        <ringAlpha>0.32</ringAlpha>
        <pulseAmplitude>0.060</pulseAmplitude>
        <vectorThrusterBurstScale>0.40</vectorThrusterBurstScale>
        <vectorThrusterGlowScale>0.54</vectorThrusterGlowScale>
        <vectorThrusterAlpha>0.82</vectorThrusterAlpha>
        <vectorThrusterGlowAlpha>0.38</vectorThrusterGlowAlpha>
        <vectorThrusterPulseScale>0.060</vectorThrusterPulseScale>
        <vectorThrusterPulseAlpha>0.24</vectorThrusterPulseAlpha>
        <vectorThrusterMotionAlphaBonus>0.28</vectorThrusterMotionAlphaBonus>
        <vectorThrusterMotionScaleBonus>0.070</vectorThrusterMotionScaleBonus>
        <vectorThrusterBackOffset>0.20</vectorThrusterBackOffset>
        <vectorThrusterSideOffset>0.215</vectorThrusterSideOffset>
        <vectorThrusterLowerBackOffset>0.360</vectorThrusterLowerBackOffset>
        <vectorThrusterLowerSideOffset>0.130</vectorThrusterLowerSideOffset>
        <vectorThrusterShoulderScale>0.96</vectorThrusterShoulderScale>
        <vectorThrusterHipScale>1.14</vectorThrusterHipScale>
        <vectorThrusterAltitudeOffset>0.030</vectorThrusterAltitudeOffset>
        <groundWakeScale>0.66</groundWakeScale>
        <groundWakeLengthScale>1.16</groundWakeLengthScale>
        <groundWakeWidthScale>0.48</groundWakeWidthScale>
        <groundWakeAlpha>0.31</groundWakeAlpha>
        <groundWakeMotionAlphaBonus>0.16</groundWakeMotionAlphaBonus>
        <groundWakeMotionLengthBonus>0.22</groundWakeMotionLengthBonus>
        <groundWakePulseScale>0.060</groundWakePulseScale>
        <groundWakePulseAlpha>0.070</groundWakePulseAlpha>
        <groundWakeBackOffset>0.14</groundWakeBackOffset>
        <groundWakeSideOffset>0.075</groundWakeSideOffset>
        <groundWakeAltitudeOffset>0.028</groundWakeAltitudeOffset>
        <draftedMoveSpeedBonus>1.05</draftedMoveSpeedBonus>
        <sparkIntervalTicks>14</sparkIntervalTicks>
        <sparkLifetimeTicks>16</sparkLifetimeTicks>
        <sparkScale>0.15</sparkScale>
        <sparkAlpha>0.48</sparkAlpha>
        <drawPriority>20</drawPriority>
      </li>
      <li Class="AbyssalProtocol.DefModExtension_ABY_ApparelAegis">
        <labelKey>ABY_ApparelAegis_GravplateLabel</labelKey>
        <gizmoSubtitleKey>ABY_ApparelAegis_GravplateGizmoSubtitle</gizmoSubtitleKey>
        <gizmoTheme>Crown</gizmoTheme>
        <gizmoTagKey>ABY_ApparelAegis_TagGravplate</gizmoTagKey>
        <gizmoIconTexPath>UI/Gizmos/ABY_AegisCrown</gizmoIconTexPath>
        <maxShieldPoints>110</maxShieldPoints>
        <rechargeDelayTicks>120</rechargeDelayTicks>
        <rechargeIntervalTicks>24</rechargeIntervalTicks>
        <rechargePerInterval>4.5</rechargePerInterval>
        <absorbRanged>true</absorbRanged>
        <absorbExplosive>true</absorbExplosive>
        <absorbMelee>false</absorbMelee>
        <empDrainsShield>true</empDrainsShield>
        <empDrainMultiplier>2.8</empDrainMultiplier>
        <suppressWhenExternalShieldWorn>true</suppressWhenExternalShieldWorn>
        <hitFlashScale>0.66</hitFlashScale>
        <breakFlashScale>1.24</breakFlashScale>
        <restoreFlashScale>1.18</restoreFlashScale>
        <breakSoundDefName>ABY_ReactorSaintImpact</breakSoundDefName>
        <restoreSoundDefName>ABY_ReactorSaintCharge</restoreSoundDefName>
        <collapseTextKey>ABY_ApparelAegis_GravplateTextCollapse</collapseTextKey>
        <restoreTextKey>ABY_ApparelAegis_GravplateTextRestore</restoreTextKey>
        <collapsePulseStrength>0.30</collapsePulseStrength>
        <restorePulseStrength>0.30</restorePulseStrength>
      </li>
      <li Class="AbyssalProtocol.DefModExtension_ABY_ApparelBodyTypeRestriction">
        <allowedBodyTypes>
          <li>Male</li>
          <li>Female</li>
          <li>Thin</li>
        </allowedBodyTypes>
      </li>
    </modExtensions>
    <comps>
      <li Class="AbyssalProtocol.CompProperties_ABY_ApparelAegisInfo" />
    </comps>
    <tradeability>Sellable</tradeability>
    <smeltable>true</smeltable>
    <smeltProducts>
      <Plasteel>56</Plasteel>
      <Uranium>18</Uranium>
      <ComponentSpacer>2</ComponentSpacer>
      <Gold>6</Gold>
    </smeltProducts>
    <equippedStatOffsets>
      <MoveSpeed>-0.02</MoveSpeed>
      <MeleeDodgeChance>0.08</MeleeDodgeChance>
      <PsychicSensitivity>-0.04</PsychicSensitivity>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>68000</WorkToMake>
      <MaxHitPoints>600</MaxHitPoints>
      <Mass>6.6</Mass>
      <MarketValue>9300</MarketValue>
      <ArmorRating_Sharp>1.30</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.68</ArmorRating_Blunt>
      <ArmorRating_Heat>1.28</ArmorRating_Heat>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="ApparelBase">
    <defName>ABY_AbyssalGravplateHelmPrototype</defName>
    <thingClass>Apparel</thingClass>
    <label>dominion gravplate helm</label>
    <description>A sealed command helm for the dominion gravplate line. Its horned faceplate and violet crown lenses translate hostile terrain, incoming fire and unstable breach vectors into a usable combat picture, letting the wearer aim while the shell beneath them refuses ordinary gravity.</description>
    <techLevel>Ultra</techLevel>
    <graphicData>
      <texPath>Things/Item/Apparel/ABY_AbyssalGravplateHelmPrototype</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.02,1.02)</drawSize>
    </graphicData>
    <apparel>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <layers>
        <li>Overhead</li>
      </layers>
      <wornGraphicPath>Things/Apparel/ABY_AbyssalGravplateHelmPrototype</wornGraphicPath>
    </apparel>
    <tradeability>Sellable</tradeability>
    <smeltable>true</smeltable>
    <smeltProducts>
      <Plasteel>20</Plasteel>
      <Uranium>6</Uranium>
      <ComponentIndustrial>1</ComponentIndustrial>
      <Gold>3</Gold>
    </smeltProducts>
    <equippedStatOffsets>
      <ShootingAccuracyPawn>0.12</ShootingAccuracyPawn>
      <MoveSpeed>0.03</MoveSpeed>
      <PsychicSensitivity>-0.06</PsychicSensitivity>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>28000</WorkToMake>
      <MaxHitPoints>340</MaxHitPoints>
      <Mass>2.20</Mass>
      <MarketValue>3900</MarketValue>
      <ArmorRating_Sharp>1.15</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.60</ArmorRating_Blunt>
      <ArmorRating_Heat>1.08</ArmorRating_Heat>
    </statBases>
  </ThingDef>
</Defs>
