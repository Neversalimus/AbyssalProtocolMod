<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="ApparelBase">
    <defName>ABY_AbyssalGravplatePrototype</defName>
    <thingClass>Apparel</thingClass>
    <label>abyssal gravplate shell</label>
    <description>A dormant dominion-grade grav-suspension shell sealed behind incomplete access law. Black crown-plating, red fracture channels and violet node lenses hint at an armor lineage meant for operators who have learned to hover at the edge of the gate rather than merely survive it.</description>
    <techLevel>Ultra</techLevel>
    <graphicData>
      <texPath>Things/Item/Apparel/ABY_AbyssalGravplatePrototype</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.16,1.16)</drawSize>
    </graphicData>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Neck</li>
        <li>Legs</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
      </layers>
      <wornGraphicPath>Things/Apparel/ABY_AbyssalGravplatePrototype</wornGraphicPath>
    </apparel>
    <modExtensions>
      <li Class="AbyssalProtocol.ABY_HoverArmorExtension">
        <draftedOnly>true</draftedOnly>
        <enableUnderfootFx>false</enableUnderfootFx>
        <enableMovingSparks>false</enableMovingSparks>
        <enableFlightRigFx>false</enableFlightRigFx>
        <enableVectorThrusterFx>true</enableVectorThrusterFx>
        <enableGroundWakeFx>true</enableGroundWakeFx>
        <vectorThrusterBurstTexPath>Effects/Hover/ABY_VectorThrusterBurst</vectorThrusterBurstTexPath>
        <vectorThrusterGlowTexPath>Effects/Hover/ABY_VectorThrusterGlow</vectorThrusterGlowTexPath>
        <groundWakeTexPath>Effects/Hover/ABY_GravWake</groundWakeTexPath>
        <groundDistortionTexPath>Effects/Hover/ABY_GravDistortion</groundDistortionTexPath>
        <hoverFxIntensity>Subtle</hoverFxIntensity>
        <ringScale>0.78</ringScale>
        <movingRingScaleBonus>0.08</movingRingScaleBonus>
        <ringAlpha>0.28</ringAlpha>
        <pulseAmplitude>0.055</pulseAmplitude>
        <vectorThrusterBurstScale>0.36</vectorThrusterBurstScale>
        <vectorThrusterGlowScale>0.50</vectorThrusterGlowScale>
        <vectorThrusterAlpha>0.76</vectorThrusterAlpha>
        <vectorThrusterGlowAlpha>0.34</vectorThrusterGlowAlpha>
        <vectorThrusterPulseScale>0.050</vectorThrusterPulseScale>
        <vectorThrusterPulseAlpha>0.20</vectorThrusterPulseAlpha>
        <vectorThrusterMotionAlphaBonus>0.24</vectorThrusterMotionAlphaBonus>
        <vectorThrusterMotionScaleBonus>0.060</vectorThrusterMotionScaleBonus>
        <vectorThrusterBackOffset>0.19</vectorThrusterBackOffset>
        <vectorThrusterSideOffset>0.205</vectorThrusterSideOffset>
        <vectorThrusterLowerBackOffset>0.340</vectorThrusterLowerBackOffset>
        <vectorThrusterLowerSideOffset>0.120</vectorThrusterLowerSideOffset>
        <vectorThrusterShoulderScale>0.92</vectorThrusterShoulderScale>
        <vectorThrusterHipScale>1.10</vectorThrusterHipScale>
        <vectorThrusterAltitudeOffset>0.028</vectorThrusterAltitudeOffset>
        <groundWakeScale>0.62</groundWakeScale>
        <groundWakeLengthScale>1.10</groundWakeLengthScale>
        <groundWakeWidthScale>0.46</groundWakeWidthScale>
        <groundWakeAlpha>0.28</groundWakeAlpha>
        <groundWakeMotionAlphaBonus>0.14</groundWakeMotionAlphaBonus>
        <groundWakeMotionLengthBonus>0.18</groundWakeMotionLengthBonus>
        <groundWakePulseScale>0.050</groundWakePulseScale>
        <groundWakePulseAlpha>0.060</groundWakePulseAlpha>
        <groundWakeBackOffset>0.13</groundWakeBackOffset>
        <groundWakeSideOffset>0.070</groundWakeSideOffset>
        <groundWakeAltitudeOffset>0.026</groundWakeAltitudeOffset>
        <draftedMoveSpeedBonus>0.90</draftedMoveSpeedBonus>
        <sparkIntervalTicks>16</sparkIntervalTicks>
        <sparkLifetimeTicks>16</sparkLifetimeTicks>
        <sparkScale>0.15</sparkScale>
        <sparkAlpha>0.46</sparkAlpha>
        <drawPriority>20</drawPriority>
      </li>
      <li Class="AbyssalProtocol.DefModExtension_ABY_ApparelBodyTypeRestriction">
        <allowedBodyTypes>
          <li>Male</li>
          <li>Female</li>
          <li>Thin</li>
        </allowedBodyTypes>
      </li>
    </modExtensions>
    <tradeability>None</tradeability>
    <smeltable>true</smeltable>
    <smeltProducts>
      <Plasteel>40</Plasteel>
      <Uranium>12</Uranium>
      <ComponentSpacer>1</ComponentSpacer>
    </smeltProducts>
    <equippedStatOffsets>
      <MoveSpeed>-0.04</MoveSpeed>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>52000</WorkToMake>
      <MaxHitPoints>540</MaxHitPoints>
      <Mass>7.0</Mass>
      <MarketValue>7200</MarketValue>
      <ArmorRating_Sharp>1.18</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.62</ArmorRating_Blunt>
      <ArmorRating_Heat>1.02</ArmorRating_Heat>
    </statBases>
  </ThingDef>
  <ThingDef ParentName="ApparelBase">
    <defName>ABY_AbyssalGravplateHelmPrototype</defName>
    <thingClass>Apparel</thingClass>
    <label>abyssal gravplate helm</label>
    <description>A sealed helm from a dormant gravplate line. Its compact horned faceplate, violet lenses and red crown-core venting make it feel less like protective equipment and more like a permission mask for forbidden motion.</description>
    <techLevel>Ultra</techLevel>
    <graphicData>
      <texPath>Things/Item/Apparel/ABY_AbyssalGravplateHelmPrototype</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.02,1.02)</drawSize>
    </graphicData>
    <apparel>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <layers>
        <li>Overhead</li>
      </layers>
      <wornGraphicPath>Things/Apparel/ABY_AbyssalGravplateHelmPrototype</wornGraphicPath>
    </apparel>
    <tradeability>None</tradeability>
    <smeltable>true</smeltable>
    <smeltProducts>
      <Plasteel>16</Plasteel>
      <Uranium>4</Uranium>
      <ComponentIndustrial>1</ComponentIndustrial>
    </smeltProducts>
    <equippedStatOffsets>
      <ShootingAccuracyPawn>0.10</ShootingAccuracyPawn>
    </equippedStatOffsets>
    <statBases>
      <WorkToMake>24000</WorkToMake>
      <MaxHitPoints>300</MaxHitPoints>
      <Mass>2.35</Mass>
      <MarketValue>3200</MarketValue>
      <ArmorRating_Sharp>1.00</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.52</ArmorRating_Blunt>
      <ArmorRating_Heat>0.90</ArmorRating_Heat>
    </statBases>
  </ThingDef>
</Defs>