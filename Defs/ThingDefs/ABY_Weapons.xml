<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>ABY_RiftCarbine</defName>
    <label>rift carbine</label>
    <description>Compact techno-demonic carbine firing condensed breach shards.</description>
    <graphicData>
      <texPath>Things/Weapon/ABY_RiftCarbine</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.36,0.55)</drawSize>
    </graphicData>
    <uiIconScale>1.38</uiIconScale>
    <soundInteract>Interact_ChargeRifle</soundInteract>
    <techLevel>Spacer</techLevel>
    <weaponTags>
      <li>Gun</li>
      <li>RangedHeavy</li>
    </weaponTags>
    <recipeMaker>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>ABY_AbyssalForge</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <ABY_AbyssalResidue>16</ABY_AbyssalResidue>
      <Plasteel>45</Plasteel>
      <ComponentIndustrial>4</ComponentIndustrial>
    </costList>
    <statBases>
      <WorkToMake>18000</WorkToMake>
      <Mass>2.8</Mass>
      <MarketValue>2300</MarketValue>
      <AccuracyTouch>0.84</AccuracyTouch>
      <AccuracyShort>0.78</AccuracyShort>
      <AccuracyMedium>0.66</AccuracyMedium>
      <AccuracyLong>0.50</AccuracyLong>
      <RangedWeapon_Cooldown>1.65</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>ABY_RiftCarbineBeamBurst</defaultProjectile>
        <warmupTime>1.10</warmupTime>
        <range>35.0</range>
        <burstShotCount>3</burstShotCount>
        <ticksBetweenBurstShots>10</ticksBetweenBurstShots>
        <soundCast>Shot_ChargeRifle</soundCast>
        <muzzleFlashScale>10</muzzleFlashScale>
      </li>
    </verbs>
    <modExtensions>
      <li Class="AbyssalProtocol.DefModExtension_AbyssalForgeUnlock">
        <requiredResidue>350</requiredResidue>
        <category>Weapons</category>
        <requiredProtocolResearchDefName>ABY_PR_RiftBallistics</requiredProtocolResearchDefName>
      </li>
    </modExtensions>
  </ThingDef>
  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>ABY_RiftBlade</defName>
    <label>rift blade</label>
    <description>A monomolecular blade caged in an infernal field. It bites through armor better than its size suggests.</description>
    <graphicData>
      <texPath>Things/Weapon/ABY_RiftBlade</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(0.96,0.96)</drawSize>
    </graphicData>
    <uiIconScale>1.22</uiIconScale>
    <recipeMaker>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <recipeUsers Inherit="False">
        <li>ABY_AbyssalForge</li>
      </recipeUsers>
    </recipeMaker>
    <costList>
      <ABY_AbyssalResidue>8</ABY_AbyssalResidue>
      <Plasteel>25</Plasteel>
      <Steel>20</Steel>
    </costList>
    <tools>
      <li>
        <label>blade</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>24</power>
        <cooldownTime>1.65</cooldownTime>
        <armorPenetration>0.58</armorPenetration>
      </li>
    </tools>
    <statBases>
      <WorkToMake>11000</WorkToMake>
      <Mass>1.9</Mass>
      <MarketValue>1180</MarketValue>
    </statBases>
    <modExtensions>
      <li Class="AbyssalProtocol.RiftDashWeaponExtension">
        <maxRange>7.9</maxRange>
        <cooldownTicks>360</cooldownTicks>
        <requireLineOfSight>true</requireLineOfSight>
      </li>
      <li Class="AbyssalProtocol.DefModExtension_AbyssalForgeUnlock">
        <requiredResidue>50</requiredResidue>
        <category>Weapons</category>
        <requiredProtocolResearchDefName>ABY_PR_BasicAbyssalArms</requiredProtocolResearchDefName>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>