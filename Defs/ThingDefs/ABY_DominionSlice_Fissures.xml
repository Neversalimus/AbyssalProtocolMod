        <drawSizeX>7.2</drawSizeX>
        <drawSizeZ>7.3</drawSizeZ>
        <altitudeOffset>0.063</altitudeOffset>
        <colorA>0.90</colorA>
      </li>
    </modExtensions>
  </ThingDef>


  <!-- Continuous path visuals: each whole fissure chain is drawn as one synced 8-frame sheet.
       Invisible blockers below provide pathing. This avoids visible connector misalignment from
       using AI-generated modular pieces as independent rotated buildings. -->
  <ThingDef Abstract="True" Name="ABY_DominionFissurePathVisualBase" ParentName="BuildingBase">
    <thingClass>AbyssalProtocol.Building_ABY_DominionFissure</thingClass>
    <category>Building</category>
    <drawerType>RealtimeOnly</drawerType>
    <tickerType>Never</tickerType>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <rotatable>false</rotatable>
    <selectable>false</selectable>
    <canOverlapZones>true</canOverlapZones>
    <useHitPoints>false</useHitPoints>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <Mass>0.1</Mass>
      <Flammability>0</Flammability>
    </statBases>
    <thingCategories Inherit="False" />
  </ThingDef>

