        <frameDurationTicks>10</frameDurationTicks>
        <drawSizeX>5.4</drawSizeX>
        <drawSizeZ>5.2</drawSizeZ>
        <altitudeOffset>0.062</altitudeOffset>
        <colorA>0.88</colorA>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="ABY_DominionFissureBase">
    <defName>ABY_DominionFissureNode</defName>
    <label>dominion fissure pressure node</label>
    <description>A wider impassable Dominion rupture node where several abyssal pressure seams meet under the ash-metal floor.</description>
    <size>(6,6)</size>
    <graphicData>
      <texPath>Things/Building/DominionSlice/Fissures/ABY_DominionFissure_Node_Sheet_A</texPath>
      <graphicClass>Graphic_Single</graphicClass>
