<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <AbyssalProtocol.ABY_TurretModuleDef>
    <defName>ABY_TMD_RiftNeedlerCore</defName>
    <label>Rift Needler Core</label>
    <description>Main weapon core for medium modular turret chassis. Fast needle bursts against lightly armored targets.</description>
    <effectSummary>Primary gun module. Gives the chassis a fast 3-shot rift-needle burst for light enemies and swarm pressure.</effectSummary>
    <slot>MainWeapon</slot>
    <thingDef>ABY_TurretModule_RiftNeedlerCore</thingDef>
    <compatibleChassisTags><li>Medium</li></compatibleChassisTags>
    <role>anti-light sustained fire</role>
    <tier>1</tier>
    <projectileDef>ABY_TurretRiftNeedleProjectile</projectileDef>
    <soundCast>ABY_RiftNeedlerFire</soundCast>
    <range>28.5</range>
    <cooldownTicks>150</cooldownTicks>
    <burstShotCount>3</burstShotCount>
    <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
    <overlayTexturePath>Things/Building/Turrets/Modules/ABY_TurretOverlay_RiftNeedlerCore</overlayTexturePath>
    <overlayDrawSize>3.25</overlayDrawSize>
    <overlayForwardOffset>0.00</overlayForwardOffset>
    <overlayPivotForwardOffset>0.00</overlayPivotForwardOffset>
    <overlayMuzzleForwardOffset>1.50</overlayMuzzleForwardOffset>
    <overlayAltitudeOffset>0.052</overlayAltitudeOffset>
  </AbyssalProtocol.ABY_TurretModuleDef>

  <AbyssalProtocol.ABY_TurretModuleDef>
    <defName>ABY_TMD_PlasmaLanceCore</defName>
    <label>Plasma Lance Core</label>
    <description>Main weapon core for medium modular turret chassis. Slower armor-focused ultra-plasma discharge.</description>
    <effectSummary>Primary gun module. Replaces the main weapon with a slower long-range ultra-plasma bolt for armor and elite targets.</effectSummary>
    <slot>MainWeapon</slot>
    <thingDef>ABY_TurretModule_PlasmaLanceCore</thingDef>
    <compatibleChassisTags><li>Medium</li></compatibleChassisTags>
    <role>anti-armor lance</role>
    <tier>2</tier>
    <projectileDef>ABY_TurretPlasmaLanceBolt</projectileDef>
    <soundCast>ABY_PlasmaLanceFire</soundCast>
    <range>33.5</range>
    <cooldownTicks>260</cooldownTicks>
    <burstShotCount>1</burstShotCount>
    <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
    <extraPowerDraw>120</extraPowerDraw>
    <overlayTexturePath>Things/Building/Turrets/Modules/ABY_TurretOverlay_PlasmaLanceCore</overlayTexturePath>
    <overlayDrawSize>3.15</overlayDrawSize>
    <overlayForwardOffset>0.00</overlayForwardOffset>
    <overlayPivotForwardOffset>0.00</overlayPivotForwardOffset>
    <overlayMuzzleForwardOffset>1.48</overlayMuzzleForwardOffset>
    <overlayAltitudeOffset>0.064</overlayAltitudeOffset>
  </AbyssalProtocol.ABY_TurretModuleDef>

  <AbyssalProtocol.ABY_TurretModuleDef>
    <defName>ABY_TMD_AshChoirRepeaterCore</defName>
    <label>Ash Choir Repeater Core</label>
    <description>Main weapon core for medium modular turret chassis. Rapid ash-canticle repeater bursts for swarm suppression.</description>
    <effectSummary>Primary gun module. Fires a fast 5-shot ash-canticle shard burst for light enemies, animals, and dense abyssal waves. Poor armor penetration keeps it dependent on lance or rail modules against elites.</effectSummary>
    <slot>MainWeapon</slot>
    <thingDef>ABY_TurretModule_AshChoirRepeaterCore</thingDef>
    <compatibleChassisTags><li>Medium</li></compatibleChassisTags>
    <role>anti-swarm ash repeater</role>
    <tier>2</tier>
    <projectileDef>ABY_TurretAshChoirShard</projectileDef>
    <soundCast>ABY_AshChoirRepeaterFire</soundCast>
    <range>30.5</range>
    <cooldownTicks>210</cooldownTicks>
    <burstShotCount>5</burstShotCount>
    <ticksBetweenBurstShots>5</ticksBetweenBurstShots>
    <extraPowerDraw>180</extraPowerDraw>
    <overlayTexturePath>Things/Building/Turrets/Modules/ABY_TurretOverlay_AshChoirRepeaterCore</overlayTexturePath>
    <overlayDrawSize>3.20</overlayDrawSize>
    <overlayForwardOffset>0.00</overlayForwardOffset>
    <overlayPivotForwardOffset>0.00</overlayPivotForwardOffset>
    <overlayMuzzleForwardOffset>1.48</overlayMuzzleForwardOffset>
    <burstMuzzleSideOffsets>
      <li>0.48</li>
      <li>0.24</li>
      <li>0.00</li>
      <li>-0.24</li>
      <li>-0.48</li>
    </burstMuzzleSideOffsets>
    <overlayAltitudeOffset>0.066</overlayAltitudeOffset>
  </AbyssalProtocol.ABY_TurretModuleDef>

  <AbyssalProtocol.ABY_TurretModuleDef>
    <defName>ABY_TMD_ChoirArcEmitter</defName>
    <label>Choir Arc Emitter</label>
    <description>Auxiliary support module. Fires a slow timed canticle-wave shot independently of the main weapon.</description>
    <effectSummary>Auxiliary module. Adds an independent timed canticle-wave support shot while the main weapon keeps firing normally.</effectSummary>
    <slot>Auxiliary</slot>
    <thingDef>ABY_TurretModule_ChoirArcEmitter</thingDef>
    <compatibleChassisTags><li>Medium</li></compatibleChassisTags>
    <role>secondary crowd pressure</role>
    <tier>2</tier>
    <projectileDef>ABY_TurretChoirArcProjectile</projectileDef>
    <soundCast>ABY_CanticleDriverFire</soundCast>
    <range>30</range>
    <cooldownTicks>420</cooldownTicks>
    <auxiliaryCooldownTicks>420</auxiliaryCooldownTicks>
    <burstShotCount>1</burstShotCount>
    <extraPowerDraw>130</extraPowerDraw>
    <overlayTexturePath>Things/Building/Turrets/Modules/ABY_TurretOverlay_ChoirArcEmitter</overlayTexturePath>
    <overlayDrawSize>0.92</overlayDrawSize>
    <overlaySideOffset>0</overlaySideOffset>
    <overlayForwardOffset>0</overlayForwardOffset>
    <overlayAltitudeOffset>0.096</overlayAltitudeOffset>
  </AbyssalProtocol.ABY_TurretModuleDef>

  <AbyssalProtocol.ABY_TurretModuleDef>
    <defName>ABY_TMD_CoolingLattice</defName>
    <label>Cooling Lattice</label>
    <description>Passive cadence module. Reduces main weapon cooldown at the cost of additional power draw.</description>
    <effectSummary>Passive module. Speeds up the main weapon cycle by reducing cooldown, but increases power draw.</effectSummary>
    <slot>Passive</slot>
    <thingDef>ABY_TurretModule_CoolingLattice</thingDef>
    <compatibleChassisTags><li>Medium</li></compatibleChassisTags>
    <role>cadence stabilizer</role>
    <tier>1</tier>
    <cooldownMultiplier>0.84</cooldownMultiplier>
    <extraPowerDraw>70</extraPowerDraw>
  </AbyssalProtocol.ABY_TurretModuleDef>

  <AbyssalProtocol.ABY_TurretModuleDef>
    <defName>ABY_TMD_TargetingSigil</defName>
    <label>Targeting Sigil</label>
    <description>Passive targeting module. Extends range and stabilizes the aiming geometry.</description>
    <effectSummary>Passive module. Extends main weapon range and improves targeting geometry, but increases power draw.</effectSummary>
    <slot>Passive</slot>
    <thingDef>ABY_TurretModule_TargetingSigil</thingDef>
    <compatibleChassisTags><li>Medium</li></compatibleChassisTags>
    <role>range and tracking</role>
    <tier>1</tier>
    <rangeOffset>3.5</rangeOffset>
    <missRadiusOffset>-0.2</missRadiusOffset>
    <extraPowerDraw>80</extraPowerDraw>
  </AbyssalProtocol.ABY_TurretModuleDef>

  <AbyssalProtocol.ABY_TurretModuleDef>
    <defName>ABY_TMD_ResidueCapacitor</defName>
    <label>Residue Capacitor</label>
    <description>Passive buffering module. Gives modest range and cadence gains while adding a larger power burden.</description>
    <effectSummary>Passive module. Modestly improves range and main weapon cadence as a balanced late basic upgrade, with a larger power burden.</effectSummary>
    <slot>Passive</slot>
    <thingDef>ABY_TurretModule_ResidueCapacitor</thingDef>
    <compatibleChassisTags><li>Medium</li></compatibleChassisTags>
    <role>charge buffer</role>
    <tier>2</tier>
    <rangeOffset>1.5</rangeOffset>
    <cooldownMultiplier>0.92</cooldownMultiplier>
    <extraPowerDraw>120</extraPowerDraw>
  </AbyssalProtocol.ABY_TurretModuleDef>


  <AbyssalProtocol.ABY_TurretModuleDef>
    <defName>ABY_TMD_SepulcherRailCore</defName>
    <label>Sepulcher Rail Core</label>
    <description>Main weapon core for medium modular turret chassis. A late-tier dual-rail gauss accelerator that charges before firing a single anti-elite penetrator.</description>
    <effectSummary>Primary gun module. Charges its twin rail planks, then fires a single high-velocity rail penetrator for long-range anti-armor and anti-elite defense. Passive cooldown modules also shorten the charge window.</effectSummary>
    <slot>MainWeapon</slot>
    <thingDef>ABY_TurretModule_SepulcherRailCore</thingDef>
    <compatibleChassisTags><li>Medium</li></compatibleChassisTags>
    <role>charged anti-elite rail sniper</role>
    <tier>4</tier>
    <projectileDef>ABY_TurretSepulcherRailSpike</projectileDef>
    <soundCharge>ABY_SepulcherRailCharge</soundCharge>
    <soundCast>ABY_SepulcherRailFire</soundCast>
    <range>52</range>
    <minRange>8</minRange>
    <cooldownTicks>720</cooldownTicks>
    <chargeTicks>150</chargeTicks>
    <burstShotCount>1</burstShotCount>
    <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
    <extraPowerDraw>520</extraPowerDraw>
    <overlayTexturePath>Things/Building/Turrets/Modules/ABY_TurretOverlay_SepulcherRailCore</overlayTexturePath>
    <overlayDrawSize>5.35</overlayDrawSize>
    <overlayForwardOffset>0.00</overlayForwardOffset>
    <overlayPivotForwardOffset>-1.28</overlayPivotForwardOffset>
    <overlayMuzzleForwardOffset>3.20</overlayMuzzleForwardOffset>
    <overlayAltitudeOffset>0.076</overlayAltitudeOffset>
    <chargeOverlayFramePathPrefix>Things/VFX/SepulcherRail/ABY_SepulcherRailCharge_</chargeOverlayFramePathPrefix>
    <chargeOverlayFrameCount>8</chargeOverlayFrameCount>
    <chargeOverlayTicksPerFrame>18</chargeOverlayTicksPerFrame>
    <chargeOverlayAltitudeOffset>0.088</chargeOverlayAltitudeOffset>
    <dischargeOverlayFramePathPrefix>Things/VFX/SepulcherRail/ABY_SepulcherRailDischarge_</dischargeOverlayFramePathPrefix>
    <dischargeOverlayFrameCount>8</dischargeOverlayFrameCount>
    <dischargeOverlayTicksPerFrame>2</dischargeOverlayTicksPerFrame>
    <dischargeOverlayAltitudeOffset>0.096</dischargeOverlayAltitudeOffset>
    <residualOverlayFramePathPrefix>Things/VFX/SepulcherRail/ABY_SepulcherRailResidual_</residualOverlayFramePathPrefix>
    <residualOverlayFrameCount>6</residualOverlayFrameCount>
    <residualOverlayTicksPerFrame>3</residualOverlayTicksPerFrame>
    <residualOverlayAltitudeOffset>0.092</residualOverlayAltitudeOffset>
  </AbyssalProtocol.ABY_TurretModuleDef>



  <AbyssalProtocol.ABY_TurretModuleDef>
    <defName>ABY_TMD_CinderMortarCore</defName>
    <label>Cinder Mortar Core</label>
    <description>Main weapon core for medium modular turret chassis. Lobs cinder-packed shells over cover to break clustered enemies and leave a short-lived burning residue field.</description>
    <effectSummary>Primary gun module. Fires an indirect cinder mortar shell with a minimum range, compact explosive splash, and a brief hot-ash residue patch for area denial. Excellent against clustered enemies and static firing lines; poor against enemies already inside the deadzone.</effectSummary>
    <slot>MainWeapon</slot>
    <thingDef>ABY_TurretModule_CinderMortarCore</thingDef>
    <compatibleChassisTags><li>Medium</li></compatibleChassisTags>
    <role>indirect cinder bombardment</role>
    <tier>3</tier>
    <projectileDef>ABY_TurretCinderMortarShell</projectileDef>
    <soundCast>ABY_AshenScattergunFire</soundCast>
    <range>40</range>
    <minRange>8</minRange>
    <targetRequiresLineOfSight>false</targetRequiresLineOfSight>
    <cooldownTicks>336</cooldownTicks>
    <chargeTicks>24</chargeTicks>
    <burstShotCount>1</burstShotCount>
    <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
    <extraPowerDraw>320</extraPowerDraw>
    <overlayTexturePath>Things/Building/Turrets/Modules/ABY_TurretOverlay_CinderMortarCore</overlayTexturePath>
    <overlayDrawSize>3.55</overlayDrawSize>
    <overlayForwardOffset>0.00</overlayForwardOffset>
    <overlayPivotForwardOffset>-0.34</overlayPivotForwardOffset>
    <overlayMuzzleForwardOffset>0.92</overlayMuzzleForwardOffset>
    <overlayAltitudeOffset>0.070</overlayAltitudeOffset>
  </AbyssalProtocol.ABY_TurretModuleDef>

<AbyssalProtocol.ABY_TurretModuleDef>
    <defName>ABY_TMD_VesperLanceArray</defName>
    <label>Vesper Lance Array</label>
    <description>Main weapon core for medium modular turret chassis. Briefly charges, then fires a focused sanction lance for armor and elite targets.</description>
    <effectSummary>Primary gun module. A saint-clean precision lance that sits between Plasma Lance and Sepulcher Rail: better reach and armor pressure than the former, far faster cadence than the latter.</effectSummary>
    <slot>MainWeapon</slot>
    <thingDef>ABY_TurretModule_VesperLanceArray</thingDef>
    <compatibleChassisTags><li>Medium</li></compatibleChassisTags>
    <role>charged precision sanction lance</role>
    <tier>3</tier>
    <projectileDef>ABY_TurretVesperLanceBolt</projectileDef>
    <soundCast>ABY_VesperLanceFire</soundCast>
    <soundCharge>ABY_VesperLanceAim</soundCharge>
    <range>40.5</range>
    <minRange>0</minRange>
    <cooldownTicks>312</cooldownTicks>
    <chargeTicks>42</chargeTicks>
    <burstShotCount>1</burstShotCount>
    <ticksBetweenBurstShots>8</ticksBetweenBurstShots>
    <extraPowerDraw>260</extraPowerDraw>
    <overlayTexturePath>Things/Building/Turrets/Modules/ABY_TurretOverlay_VesperLanceArray</overlayTexturePath>
    <overlayDrawSize>3.85</overlayDrawSize>
    <overlayForwardOffset>0.00</overlayForwardOffset>
    <overlayPivotForwardOffset>-0.62</overlayPivotForwardOffset>
    <overlayMuzzleForwardOffset>1.72</overlayMuzzleForwardOffset>
    <overlayAltitudeOffset>0.068</overlayAltitudeOffset>
    <chargeOverlayFramePathPrefix>Things/VFX/VesperLanceArray/ABY_VesperLanceArrayCharge_</chargeOverlayFramePathPrefix>
    <chargeOverlayFrameCount>8</chargeOverlayFrameCount>
    <chargeOverlayTicksPerFrame>5</chargeOverlayTicksPerFrame>
    <chargeOverlayAltitudeOffset>0.084</chargeOverlayAltitudeOffset>
    <dischargeOverlayFramePathPrefix>Things/VFX/VesperLanceArray/ABY_VesperLanceArrayDischarge_</dischargeOverlayFramePathPrefix>
    <dischargeOverlayFrameCount>6</dischargeOverlayFrameCount>
    <dischargeOverlayTicksPerFrame>2</dischargeOverlayTicksPerFrame>
    <dischargeOverlayAltitudeOffset>0.094</dischargeOverlayAltitudeOffset>
  </AbyssalProtocol.ABY_TurretModuleDef>

</Defs>
