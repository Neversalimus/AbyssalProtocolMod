      <texPath>Things/VFX/DominionSlice/ABY_DominionSlice_VoidVeil</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(1.00,1.00)</drawSize>
      <color>(115,71,179,87)</color>
    </graphicData>
    <mote>
      <fadeInTime>0.090</fadeInTime>
      <solidTime>0.420</solidTime>
      <fadeOutTime>1.000</fadeOutTime>
      <growthRate>0.020</growthRate>
    </mote>
  </ThingDef>

  <ThingDef ParentName="MoteBase">
    <defName>ABY_Mote_DominionWeatherFurnaceDrift</defName>
