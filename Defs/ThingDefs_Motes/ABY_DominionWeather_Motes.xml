<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Package 5: hell-only Dominion weather layer. Uses existing Dominion Slice VFX textures; no new art assets required. -->

  <ThingDef ParentName="MoteBase">
    <defName>ABY_Mote_DominionWeatherAsh</defName>
    <label>dominion weather ash</label>
    <thingClass>MoteThrown</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/VFX/DominionSlice/ABY_DominionSlice_CohesionQuietEmber</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(0.86,0.86)</drawSize>
      <color>(0.48,0.45,0.40,0.70)</color>
    </graphicData>
    <mote>
      <fadeInTime>0.080</fadeInTime>
      <solidTime>0.760</solidTime>
      <fadeOutTime>1.350</fadeOutTime>
      <growthRate>0.018</growthRate>
    </mote>
  </ThingDef>

  <ThingDef ParentName="MoteBase">
