<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Dominion Sepulcher weather motes: custom tiny particles cut from the generated weather sheet. -->

  <ThingDef ParentName="MoteBase">
    <defName>ABY_Mote_DominionWeatherAsh</defName>
    <label>dominion ash speck</label>
    <thingClass>MoteThrown</thingClass>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <drawOffscreen>true</drawOffscreen>
    <tickerType>Normal</tickerType>
    <graphicData>
      <texPath>Things/VFX/DominionWeather/ABY_DominionWeather_AshSpeck</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawSize>(0.34,0.34)</drawSize>
      <color>(0.56,0.53,0.48,0.74)</color>
    </graphicData>
    <mote>
      <fadeInTime>0.060</fadeInTime>
      <solidTime>0.620</solidTime>
      <fadeOutTime>1.150</fadeOutTime>
      <growthRate>0.010</growthRate>
    </mote>
  </ThingDef>

