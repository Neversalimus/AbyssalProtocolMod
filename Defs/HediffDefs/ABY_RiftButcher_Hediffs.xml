<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>ABY_RiftButcherCarapace</defName>
    <label>severance carapace</label>
    <description>The Rift Butcher enters through a temporary severance shell, shrugging off the first volley long enough to force a real engagement.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <defaultLabelColor>(0.70, 0.18, 1.00)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>900</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <statOffsets>
          <ArmorRating_Sharp>0.12</ArmorRating_Sharp>
          <ArmorRating_Blunt>0.07</ArmorRating_Blunt>
          <MeleeDodgeChance>0.04</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>ABY_RiftButcherHookSnare</defName>
    <label>hook-snarled</label>
    <description>A rift hook has bitten into armor seams and dragged the victim's movement into the Butcher's cadence.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <defaultLabelColor>(0.88, 0.12, 1.00)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>360</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <statOffsets>
          <MoveSpeed>-0.32</MoveSpeed>
          <ShootingAccuracyPawn>-0.07</ShootingAccuracyPawn>
          <MeleeHitChance>-0.03</MeleeHitChance>
          <MeleeDodgeChance>-0.04</MeleeDodgeChance>
        </statOffsets>
      </li>
      <li>
        <minSeverity>0.55</minSeverity>
        <statOffsets>
          <MoveSpeed>-0.48</MoveSpeed>
          <ShootingAccuracyPawn>-0.11</ShootingAccuracyPawn>
          <MeleeHitChance>-0.05</MeleeHitChance>
          <MeleeDodgeChance>-0.06</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>ABY_RiftButcherSeveredLine</defName>
    <label>severed line</label>
    <description>The victim's stance and aim are briefly split by a Dominion cut, leaving them slow to reposition after the Butcher's sweep or dash.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <defaultLabelColor>(1.00, 0.16, 0.10)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>240</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <statOffsets>
          <MoveSpeed>-0.38</MoveSpeed>
          <ShootingAccuracyPawn>-0.08</ShootingAccuracyPawn>
          <MeleeDodgeChance>-0.05</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>ABY_RiftButcherExecutionFocus</defName>
    <label>execution focus</label>
    <description>The Butcher's failing frame sheds restraint and routes more power into pursuit, hook timing and close-range killing pressure.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <defaultLabelColor>(1.00, 0.12, 0.08)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>300</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <statOffsets>
          <MoveSpeed>0.42</MoveSpeed>
          <MeleeHitChance>0.08</MeleeHitChance>
          <MeleeDodgeChance>0.04</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
