<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>ABY_ChoirResonance</defName>
    <label>choir resonance</label>
    <description>The target's body is carrying a fragment of the Oblivion Choir's breach-song. Each branch strike drives the harmonic deeper; when the core detonates, stored resonance answers the blast.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <scenarioCanAdd>false</scenarioCanAdd>
    <defaultLabelColor>(0.34, 0.68, 1.00)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
        <disappearsAfterTicks>420</disappearsAfterTicks>
      </li>
      <li Class="HediffCompProperties_DisappearsOnDeath" />
    </comps>
    <stages>
      <li>
        <minSeverity>0.01</minSeverity>
        <label>humming</label>
        <statOffsets>
          <MoveSpeed>-0.04</MoveSpeed>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.03</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.35</minSeverity>
        <label>answering</label>
        <statOffsets>
          <MoveSpeed>-0.08</MoveSpeed>
          <ArmorRating_Heat>-0.08</ArmorRating_Heat>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.06</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.04</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.70</minSeverity>
        <label>rupturing</label>
        <statOffsets>
          <MoveSpeed>-0.13</MoveSpeed>
          <ArmorRating_Sharp>-0.05</ArmorRating_Sharp>
          <ArmorRating_Heat>-0.16</ArmorRating_Heat>
        </statOffsets>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.10</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.07</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

</Defs>
