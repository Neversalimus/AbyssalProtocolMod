<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <RecipeDef>
    <defName>ABY_CraftGatebreakerCarapace</defName>
    <label>forge gatebreaker carapace</label>
    <description>Rebuild a saint-grade core shell into a black abyssal assault carapace meant for the next gate, not the last battle. This pattern sacrifices reactor remnant geometry for heavier anti-breach plating and a more openly hostile battlefield profile.</description>
    <jobString>Forging gatebreaker carapace.</jobString>
    <workAmount>6600</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <recipeUsers>
      <li>ABY_AbyssalForge</li>
    </recipeUsers>
    <researchPrerequisite>ABY_DominionGateBootstrapping</researchPrerequisite>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ABY_ReactorSaintCore</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ABY_AbyssalResidue</li>
          </thingDefs>
        </filter>
        <count>52</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>118</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Uranium</li>
          </thingDefs>
        </filter>
        <count>34</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentSpacer</li>
          </thingDefs>
        </filter>
        <count>5</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Gold</li>
          </thingDefs>
        </filter>
        <count>14</count>
      </li>
    </ingredients>
    <products>
      <ABY_GatebreakerCarapace>1</ABY_GatebreakerCarapace>
    </products>
    <modExtensions>
      <li Class="AbyssalProtocol.DefModExtension_AbyssalForgeUnlock">
        <requiredResidue>1800</requiredResidue>
        <category>Armor</category>
      </li>
    </modExtensions>
  </RecipeDef>

  <RecipeDef>
    <defName>ABY_CraftGatebreakerHelm</defName>
    <label>forge gatebreaker helm</label>
    <description>Condense saint-class field hardware and black plasteel into a sealed predatory gate helm. The result is less ceremonial than crowned gear and more direct: an execution visor for controlled breaches that are expected to fight back.</description>
    <jobString>Forging gatebreaker helm.</jobString>
    <workAmount>3000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <recipeUsers>
      <li>ABY_AbyssalForge</li>
    </recipeUsers>
    <researchPrerequisite>ABY_DominionGateBootstrapping</researchPrerequisite>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ABY_SaintCondensationCell</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ABY_AbyssalResidue</li>
          </thingDefs>
        </filter>
        <count>24</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>52</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Uranium</li>
          </thingDefs>
        </filter>
        <count>13</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>3</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Gold</li>
          </thingDefs>
        </filter>
        <count>6</count>
      </li>
    </ingredients>
    <products>
      <ABY_GatebreakerHelm>1</ABY_GatebreakerHelm>
    </products>
    <modExtensions>
      <li Class="AbyssalProtocol.DefModExtension_AbyssalForgeUnlock">
        <requiredResidue>1800</requiredResidue>
        <category>Armor</category>
      </li>
    </modExtensions>
  </RecipeDef>

</Defs>
