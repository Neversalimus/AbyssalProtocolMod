<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <RecipeDef>
    <defName>ABY_CraftCrudeStabilizerModule</defName>
    <label>forge crude stabilizer module</label>
    <description>Assemble a heavy circle frame that can be inserted into one edge of the abyssal summoning circle to keep early containment from tearing the world too sharply.</description>
    <jobString>Forging crude stabilizer module.</jobString>
    <workAmount>1600</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <skillRequirements>
      <Crafting>7</Crafting>
    </skillRequirements>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <researchPrerequisite>ABY_CircleStabilizerFrames</researchPrerequisite>
    <recipeUsers>
      <li>ABY_AbyssalForge</li>
    </recipeUsers>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ABY_AbyssalResidue</li>
          </thingDefs>
        </filter>
        <count>10</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>35</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>2</count>
      </li>
    </ingredients>
    <products>
      <ABY_CrudeStabilizerModule>1</ABY_CrudeStabilizerModule>
    </products>
    <modExtensions>
      <li Class="AbyssalProtocol.DefModExtension_AbyssalForgeUnlock">
        <requiredResidue>100</requiredResidue>
        <category>Core</category>
      </li>
    </modExtensions>
  </RecipeDef>
