      <ABY_GatebreakerAnchorHarness>1</ABY_GatebreakerAnchorHarness>
    </products>
    <skillRequirements>
      <Crafting>12</Crafting>
    </skillRequirements>
    <modExtensions>
      <li Class="AbyssalProtocol.DefModExtension_AbyssalForgeUnlock">
        <requiredResidue>1800</requiredResidue>
        <category>Armor</category>
        <requiredProtocolResearchDefName>ABY_PR_GatebreakerCarapaceLogic</requiredProtocolResearchDefName>
      </li>
    </modExtensions>
  </RecipeDef>
