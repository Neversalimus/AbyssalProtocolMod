<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <RecipeDef>
    <defName>ABY_CraftAbyssalGravplatePrototype</defName>
    <label>forge dominion gravplate shell</label>
    <description>Bind crowned-core pressure, dominion crown shards and a dense grav-suspension lattice into a human-scale survival shell. The result is not a heavier carapace; it is a breach frame for fighters expected to cross hostile ground under fire.</description>
    <jobString>Forging dominion gravplate shell.</jobString>
    <workAmount>68000</workAmount>
    <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
    <workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking>
    <soundWorking>Recipe_Smith</soundWorking>
    <recipeUsers>
      <li>ABY_AbyssalForge</li>
    </recipeUsers>
    <researchPrerequisite>ABY_DominionGateBootstrapping</researchPrerequisite>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>ABY_CrownedCoreFragment</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
