      <li><filter><thingDefs><li>DevilstrandCloth</li></thingDefs></filter><count>20</count></li>
      <li><filter><thingDefs><li>Plasteel</li></thingDefs></filter><count>12</count></li>
      <li><filter><thingDefs><li>ComponentIndustrial</li></thingDefs></filter><count>1</count></li>
