<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!--
    Item classification compatibility pass.
    External storage frameworks and repair utilities can inspect a ThingDef's direct
    thingCategories list instead of relying on inherited parent categories.  Make every
    Abyssal weapon/apparel definition explicitly advertise its vanilla item category.
    This intentionally does not alter techLevel, tradeability, destroyOnDrop, repair
    behavior, or enemy-only drop policy.
  -->

  <!-- Weapons -->
  <Operation Class="PatchOperationConditional">
    <xpath>/Defs/ThingDef[defName="ABY_AnchorSpiker"]/thingCategories</xpath>
    <match Class="PatchOperationConditional">
      <xpath>/Defs/ThingDef[defName="ABY_AnchorSpiker"]/thingCategories/li[text()="Weapons"]</xpath>
      <nomatch Class="PatchOperationAdd">
        <xpath>/Defs/ThingDef[defName="ABY_AnchorSpiker"]/thingCategories</xpath>
        <value>
          <li>Weapons</li>
        </value>
      </nomatch>
    </match>
    <nomatch Class="PatchOperationAdd">
      <xpath>/Defs/ThingDef[defName="ABY_AnchorSpiker"]</xpath>
      <value>
        <thingCategories>
          <li>Weapons</li>
        </thingCategories>
      </value>
    </nomatch>
  </Operation>
